APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
WEB_PORT=5173
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/album.sqlite3
MODEL_DIR=./models
DEFAULT_HOUSEHOLD_TIMEZONE=Asia/Shanghai
OLLAMA_BASE_URL=http://127.0.0.1:11434
